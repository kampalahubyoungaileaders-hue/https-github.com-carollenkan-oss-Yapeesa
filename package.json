{
  "name": "yapesa",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:apps": "turbo run dev",
    "infra:up": "node scripts/infra.mjs up",
    "infra:down": "node scripts/infra.mjs down",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo run typecheck && tsc -p supabase/functions/tsconfig.json",
    "test": "node --test tooling/*.test.mjs && pnpm test:sms && turbo run test",
    "test:sms": "node --import tsx --test supabase/functions/tests/*.test.ts",
    "build": "turbo run build",
    "mobile:export": "pnpm --filter @yapesa/mobile export:android",
    "smoke:stack": "node scripts/smoke-stack.mjs",
    "test:web": "playwright test",
    "api:generate": "node --import tsx scripts/generate-api.ts",
    "local:provision": "node --import tsx scripts/provision-local.ts",
    "local:test-stack": "node scripts/start-test-stack.mjs",
    "test:integration": "node --env-file=.env --import tsx --test integration/*.test.ts",
    "test:live": "node --env-file=.env scripts/test-live-browsers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.0.0",
    "@types/pg": "8.15.5",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "openapi-typescript": "7.13.0",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "standardwebhooks": "1.0.0",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "uuid": "14.0.3"
  },
  "type": "module"
}
