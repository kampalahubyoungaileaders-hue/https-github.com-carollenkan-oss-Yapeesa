# Local development only. Never use these defaults for real records.
FINERACT_DB_PASSWORD=yapesa_local_only
FINERACT_MASTER_PASSWORD=yapesa_local_master_only
# Actual tenant-registry encryption key for NEW development databases.
# Existing volumes without this variable retain the legacy native key.
# Do not change/add this value for an existing registry without key rotation.
FINERACT_TENANT_MASTER_PASSWORD=yapesa_local_tenant_master_only

# Secure API: set complete server-only values in an ignored .env file.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-enabled-publishable-key
# PIN_PEPPER=generate-at-least-32-random-bytes
# AUTH_GATEWAY_KEY=generate-at-least-32-random-bytes
# SESSION_COOKIE_KEY=generate-32-random-bytes-encoded-as-64-hex-characters
# WEB_ORIGIN=http://127.0.0.1:5173
# API_HOST=127.0.0.1
