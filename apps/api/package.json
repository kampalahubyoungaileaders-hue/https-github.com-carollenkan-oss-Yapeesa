{
  "name": "@yapesa/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.8",
    "@fastify/swagger": "9.9.3",
    "@yapesa/domain": "workspace:*",
    "@yapesa/i18n": "workspace:*",
    "fastify": "5.12.6",
    "pdfkit": "0.20.2"
  },
  "devDependencies": {
    "@types/pdfkit": "0.17.7"
  }
}
